{
  "name": "@edeng23/pines",
  "version": "0.1.5",
  "description": "Tree-first orchestration TUI for pi coding agents. pi + trees = pines.",
  "license": "Apache-2.0",
  "author": "Eden Gaon",
  "homepage": "https://github.com/edeng23/pines#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edeng23/pines.git"
  },
  "bugs": {
    "url": "https://github.com/edeng23/pines/issues"
  },
  "keywords": [
    "pi",
    "pi-agent",
    "coding-agent",
    "agent-orchestrator",
    "orchestrator",
    "tui",
    "terminal",
    "forest"
  ],
  "type": "module",
  "bin": {
    "pines": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "scripts/fix-node-pty.mjs",
    "src/extension/",
    "src/store/schema.sql"
  ],
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "predemo": "pnpm build",
    "demo": "node scripts/demo.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "esbuild",
      "onnxruntime-node"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "vitest": "^3.0.0"
  }
}
